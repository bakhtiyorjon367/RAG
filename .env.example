# Supabase (use cloud URL from dashboard; local CLI optional: http://localhost:54321)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Embedding
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
# Optional: persistent fastembed cache dir (default: system temp)
# FASTEMBED_CACHE_PATH=./backend/.fastembed_cache

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Reranking (improves relevance: scores query-chunk pairs and filters by SEARCH_SCORE_THRESHOLD; set to "none" to disable)
RERANK_MODEL=flashrank/ms-marco-MiniLM-L-12-v2

# Search
TOP_K=5
SEARCH_SCORE_THRESHOLD=0.3  # Minimum relevance score (0-1) to include a result when reranker is active
MAX_UPLOAD_SIZE_MB=50

# CORS (JSON array; add production frontend URL when deploying)
CORS_ORIGINS=["http://localhost:5173"]

# LLM (required for /chat)
# GEMINI_API_KEY=your-gemini-api-key

# Frontend (Vite — baked in at build time for production)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=http://localhost:8000
