# OPTIONAL: serve RAG under http://<host>/rag/ on port 80 (alongside another app on /).
# Requires rebuilding the frontend with base: '/rag/' in vite.config.ts.
# This file is an example only — not wired into CI by default.

server {
    listen 80;
    server_name _;

    location /rag/api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location /rag/ {
        alias /var/www/rag-frontend/;
        try_files $uri $uri/ /rag/index.html;
    }
}
