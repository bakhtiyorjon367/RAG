# Production backend API (CPU inference, no reload)
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV FASTEMBED_CACHE_PATH=/app/.fastembed_cache
ENV EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Bake embedding weights into the image so EC2 does not download at startup.
RUN mkdir -p /app/.fastembed_cache && python scripts/bake_embedding_model.py

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')" || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
