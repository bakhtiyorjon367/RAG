# Production environment template (copy values to AWS Secrets / Amplify / ECS)
# Do not commit real secrets.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

GEMINI_API_KEY=your-gemini-api-key

# Exact frontend origin(s) — JSON array
CORS_ORIGINS=["https://app.example.com"]

FASTEMBED_CACHE_PATH=/tmp/fastembed

# Frontend build-time only (Amplify / docker build / deploy-frontend-s3.sh)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=https://api.example.com
